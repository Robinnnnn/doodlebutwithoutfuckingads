{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doodlebutwithoutfuckingads",
  "account_id": "24dc07a5c5e31612dcfb4c4855da14df",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "doodlebutwithoutfuckingads.com",
      "custom_domain": true
    },
    {
      "pattern": "www.doodlebutwithoutfuckingads.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doodlebutwithoutfuckingads-db",
      "database_id": "4fa43e90-beb4-44c2-b95d-3895cd2606fa",
      "migrations_dir": "./drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "POLL_CREATE_RATE_LIMITER",
      "namespace_id": "2026072801",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "POLL_READ_RATE_LIMITER",
      "namespace_id": "2026072802",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "POLL_RESPONSE_RATE_LIMITER",
      "namespace_id": "2026072803",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
